DATABASE_URL=
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCHOLARSHIP_STORAGE_KEY=
# Set false only for loopback HTTP demos.
COOKIE_SECURE=true
PORT=3000

# MahaSetu verification (server-side only). The token is the requester credential Core registered for this service
# (Core's REQUESTER_TOKEN_SCHOLARSHIP). The site URL is where the applicant's browser is sent, so it must be reachable
# from the browser; the Core URL is reached by this portal's server.
MAHASETU_CORE_URL=http://localhost:8000
MAHASETU_SITE_URL=http://localhost:3004
MAHASETU_REQUESTER_TOKEN=
MAHASETU_SERVICE_ID=DEMO-PMS
